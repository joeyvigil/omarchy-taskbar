{
  "schemaVersion": 1,
  "id": "io.github.joeyvigil.taskbar",
  "name": "Taskbar",
  "version": "0.3.1",
  "author": "Joey Vigil",
  "license": "MIT",
    "description": "Pinned apps and running windows in the bar with hover window list; pin and unpin from the bar itself",
    "kinds": [
        "bar-widget"
    ],
    "entryPoints": {
        "barWidget": "BarWidget.qml"
    },
    "barWidget": {
        "displayName": "Taskbar",
        "description": "Pinned app icons plus running apps; left = launch or focus, right = actions, middle = new instance; hover a running app to pick a window",
        "category": "Launcher",
        "allowMultiple": false,
        "defaultSection": "left",
        "defaults": {
            "apps": [],
            "iconSize": 17,
            "spacing": 2,
            "runningIndicator": true,
            "dimWhenClosed": true,
            "cycleWindows": true,
            "showAddButton": true,
            "showRunningApps": true,
            "hoverWindowList": true,
            "hoverListMinWindows": 2
        },
    "schema": [
      {
        "key": "apps",
        "type": "array",
        "label": "Pinned apps"
      },
      {
        "key": "iconSize",
        "type": "number",
        "label": "Icon size (px)"
      },
      {
        "key": "spacing",
        "type": "number",
        "label": "Gap between icons (px)"
      },
      {
        "key": "runningIndicator",
        "type": "bool",
        "label": "Show running indicator"
      },
      {
        "key": "dimWhenClosed",
        "type": "bool",
        "label": "Dim icons for apps that are not running"
      },
      {
        "key": "cycleWindows",
        "type": "bool",
        "label": "Re-clicking a focused app cycles its windows"
      },
      {
        "key": "showAddButton",
        "type": "bool",
        "label": "Show the + button for pinning apps"
      },
      {
        "key": "showRunningApps",
        "type": "bool",
        "label": "Show running apps that are not pinned"
      },
      {
        "key": "hoverWindowList",
        "type": "bool",
        "label": "Show window list on hover"
      },
      {
        "key": "hoverListMinWindows",
        "type": "number",
        "label": "Min windows to show hover list",
        "min": 1,
        "max": 10,
        "step": 1,
        "defaultValue": 2
      }
    ]
  }
}
